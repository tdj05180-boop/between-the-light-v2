      "lockMovement": true,
      "camera": {
        "preset": "close",
        "target": {
          "x": -3.4,
          "y": 1.05,
          "z": -2.2
        }
      },
      "lines": [
        {
          "text": "2003년, 결혼 후 사업이 잘되지 않아\n힘든 시기를 보냈습니다.",
          "durationMs": 4500
        },
        {
          "text": "이 작은 공간은 그 시기를 표현한 무대입니다.\n남은 상자들을 하나씩 제자리에 놓아보세요.",
          "durationMs": 5000
        }
      ]
    },
    "boxes": {
      "speaker": "다음 한 걸음",
      "lockMovement": true,
      "lines": [
        {
          "text": "남아 있는 것들을 정리했습니다.\n오른쪽의 작은 등불을 살펴보세요.",
          "durationMs": 4000
        }
      ]
    },
    "lighting": {
      "speaker": "이어지는 길",
